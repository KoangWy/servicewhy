# Copy to .env ONLY for FULL mode (it sets SAMPLE_MODE=false below). Never commit .env.
# With no .env at all, `docker compose up` runs SAMPLE mode: no keys, no services.

# ── Runtime ──────────────────────────────────────────────────────────────────
# true = replay the recorded run: no network, no services, no keys
SAMPLE_MODE=false
# zetaris (judged FULL path) | local (keyless dev/tests only)
DATA_BACKEND=zetaris
# live | record (QA machine) | replay (cassettes) | fake (offline dev/tests)
MODEL_MODE=live
# per-run model call budget
MODEL_MAX_CALLS=40
LOG_LEVEL=INFO
PORT=8000
UI_PORT=5173
SIM_SEED=20261024
SIM_DAYS=35

# ── Model provider (OpenCode Go — OpenAI-compatible) ────────────────────────
MODEL_API_KEY=your-opencode-go-key-here
MODEL_BASE_URL=https://opencode.ai/zen/go/v1
MODEL_ID=deepseek-v4.1-flash
# OpenCode Go requires a `x-opencode-session: <uuid>` header per conversation; the app derives one per
# investigation run. Backup provider (DeepInfra, OpenAI-compatible), used after repeated transport errors:
MODEL_BACKUP_API_KEY=
MODEL_BACKUP_BASE_URL=https://api.deepinfra.com/v1/openai
MODEL_BACKUP_ID=your-deepinfra-model-id

# ── Zetaris (local Docker bundle is the primary deployment) ─────────────────
# REST is the adapter's channel. Local bundle ports: 3000 UI/login, 8888 REST, 10000 JDBC.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_LOGIN_URL=http://localhost:3000/api
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=change-me
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_ORG_ID=your-org-id-here
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=/path/to/zetaris-jdbc-driver.jar
# Names the init job registers, and how the Zetaris containers reach our stores
ZETARIS_PG_SOURCE=svc_pg
ZETARIS_FS_DATABASE=svc_fs
ZETARIS_PG_HOST=host.docker.internal
ZETARIS_S3_ENDPOINT=http://host.docker.internal:9000

# ── Stores (compose services `postgres` and `minio`, profile "full") ─────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svcwhy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servicewhy
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=svcwhy
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=servicewhy
