# FULL-mode template: `cp .env.example .env`, then fill the placeholders. It sets SAMPLE_MODE=false below.
# Never commit .env. With no .env at all, `docker compose up` runs SAMPLE mode: no keys, no services.
# `make full` (scripts/up-full.sh) checks this file, Zetaris and Nightshift before it starts the stack.

# ── Runtime ──────────────────────────────────────────────────────────────────
# true = replay the recorded run: no network, no services, no keys
SAMPLE_MODE=false
# zetaris (judged FULL path) | local (keyless dev/tests only)
DATA_BACKEND=zetaris
# live | record (QA machine) | replay (cassettes) | fake (offline dev/tests)
MODEL_MODE=live
# per-run model call budget
MODEL_MAX_CALLS=40
LOG_LEVEL=INFO
PORT=8000
UI_PORT=5173
SIM_SEED=20261024
SIM_DAYS=35

# ── Model provider ───────────────────────────────────────────────────────────
# meterless (primary: Meterless Nightshift) | opencode (secondary: OpenCode Go)
MODEL_PROVIDER=meterless

# ── Primary: Meterless Nightshift (desktop app, OpenAI-compatible Runtime) ───
# Nightshift's Console shows the Nightshift URL and the Runtime API key. The underlying provider key (NVIDIA,
# OpenRouter, ...) is entered in Nightshift's Providers tab and NEVER here: this app only needs the Runtime token.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token-here
# meterless/auto is a routing mode, not a model id. Observed: with no cloud lane it is answered by a 1B on-device model, which
# is too small for this agent. Set a concrete cloud model id from GET /v1/models (or the Settings screen) to pin one.
METERLESS_MODEL=meterless/auto
METERLESS_APP=servicewhy

# ── Secondary: OpenCode Go (OpenAI-compatible), used when MODEL_PROVIDER=opencode ──
MODEL_API_KEY=your-opencode-go-key-here
MODEL_BASE_URL=https://opencode.ai/zen/go/v1
MODEL_ID=deepseek-v4.1-flash
# OpenCode Go requires a `x-opencode-session: <uuid>` header per conversation; the app derives one per
# investigation run. Backup provider (DeepInfra, OpenAI-compatible), used after repeated transport errors:
MODEL_BACKUP_API_KEY=
MODEL_BACKUP_BASE_URL=https://api.deepinfra.com/v1/openai
MODEL_BACKUP_ID=your-deepinfra-model-id

# ── Zetaris (local Docker bundle is the primary deployment) ─────────────────
# REST is the adapter's channel. Local bundle ports: 3000 UI/login, 8888 REST, 10000 JDBC.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_LOGIN_URL=http://localhost:3000/api
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=change-me
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_ORG_ID=your-org-id-here
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=/path/to/zetaris-jdbc-driver.jar
# Names the init job registers, and how the Zetaris containers reach our stores
ZETARIS_PG_SOURCE=svc_pg
ZETARIS_FS_DATABASE=svc_fs
ZETARIS_PG_HOST=host.docker.internal
ZETARIS_S3_ENDPOINT=http://host.docker.internal:9000

# ── Stores (compose services `postgres` and `minio`, profile "full") ─────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svcwhy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servicewhy
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=svcwhy
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=servicewhy
