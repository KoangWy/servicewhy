# ── Model provider (OpenCode Go — OpenAI-compatible) ────────────────────────
MODEL_API_KEY=your-opencode-go-key-here
MODEL_BASE_URL=https://opencode.ai/zen/go/v1
MODEL_ID=deepseek-v4.1-flash
# OpenCode Go requires a `x-opencode-session: <uuid>` header per conversation for
# context continuity and prompt caching. The app derives it per investigation
# run; no configuration needed here.

# ── Zetaris (local Docker install is the primary deployment) ────────────────
# Exact JDBC URL format comes from the getting-started repo; verified at the
# day-1 gate before being relied on.
ZETARIS_JDBC_URL=jdbc:zetaris://localhost:19000/db
ZETARIS_USER=admin
ZETARIS_PASSWORD=change-me

# ── Stores ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=svcwhy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servicewhy

# ── Runtime ──────────────────────────────────────────────────────────────────
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000
UI_PORT=5173
SIM_SEED=20261024
